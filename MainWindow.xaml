<Window x:Class="SCPDrop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SCP Drop" Width="520" Height="520" MinWidth="380" MinHeight="400"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Connection picker -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Send to:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" />
            <Button x:Name="ManageButton" DockPanel.Dock="Right" Content="Manage…" Margin="8,0,0,0" Click="Manage_Click" />
            <ComboBox x:Name="ConnectionCombo" DisplayMemberPath="Name" SelectionChanged="ConnectionCombo_SelectionChanged" />
        </DockPanel>

        <!-- Drop zone -->
        <Grid Grid.Row="1" x:Name="DropZone" AllowDrop="True" Background="#FFF7F9FC"
              DragEnter="DropZone_DragOver" DragOver="DropZone_DragOver" DragLeave="DropZone_DragLeave" Drop="DropZone_Drop">
            <Rectangle x:Name="DropBorder" Stroke="#FF8AA4C8" StrokeThickness="2" StrokeDashArray="4 3" RadiusX="8" RadiusY="8" />
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12">
                <TextBlock Text="⇪" FontSize="40" HorizontalAlignment="Center" Foreground="#FF5A7BA8" />
                <TextBlock x:Name="DropText" Text="Drop files or folders here" FontSize="18" HorizontalAlignment="Center" Foreground="#FF33475B" />
                <TextBlock x:Name="TargetText" Margin="0,6,0,10" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="#FF6B7C8F" FontFamily="Consolas" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="BrowseFilesButton" Content="Browse files…" Margin="0,0,8,0" Click="BrowseFiles_Click" />
                    <Button x:Name="BrowseFolderButton" Content="Browse folder…" Click="BrowseFolder_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Progress -->
        <Grid Grid.Row="2" Margin="0,10,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="StatusText" Text="Ready." TextTrimming="CharacterEllipsis" Margin="0,0,0,3" />
                <ProgressBar x:Name="Progress" Height="14" Minimum="0" Maximum="100" />
            </StackPanel>
            <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Margin="8,0,0,0" VerticalAlignment="Bottom"
                    IsEnabled="False" Click="Cancel_Click" />
        </Grid>

        <!-- Log -->
        <TextBox x:Name="LogBox" Grid.Row="3" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />

        <DockPanel Grid.Row="4" Margin="0,8,0,0">
            <CheckBox x:Name="TopmostCheck" Content="Always on top" VerticalAlignment="Center"
                      Checked="Topmost_Changed" Unchecked="Topmost_Changed" />
            <Button DockPanel.Dock="Right" Content="Clear log" HorizontalAlignment="Right" Click="ClearLog_Click" />
        </DockPanel>
    </Grid>
</Window>
