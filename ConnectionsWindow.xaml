<Window x:Class="SCPDrop.ConnectionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Connections" Width="760" Height="560" MinWidth="640" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Connection list -->
        <DockPanel Grid.Column="0" Margin="0,0,12,0">
            <UniformGrid DockPanel.Dock="Bottom" Columns="3" Margin="0,8,0,0">
                <Button Content="Add" MinWidth="0" Margin="0,0,4,0" Click="Add_Click" />
                <Button Content="Copy" MinWidth="0" Margin="2,0" Click="Duplicate_Click" />
                <Button Content="Delete" MinWidth="0" Margin="4,0,0,0" Click="Delete_Click" />
            </UniformGrid>
            <ListBox x:Name="ConnectionList" DisplayMemberPath="Name" SelectionChanged="ConnectionList_SelectionChanged" />
        </DockPanel>

        <!-- Editor -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="FormPanel" Grid.IsSharedSizeScope="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Margin" Value="0,0,10,0" />
                    </Style>
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="34" />
                    <RowDefinition Height="34" />
                    <RowDefinition Height="34" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="34" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="34" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Name" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" VerticalAlignment="Center" LostFocus="NameBox_LostFocus" />

                <TextBlock Grid.Row="1" Text="Host / IP" />
                <Grid Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="HostBox" />
                    <TextBlock Grid.Column="1" Text="Port" Margin="10,0,6,0" />
                    <TextBox Grid.Column="2" x:Name="PortBox" />
                </Grid>

                <TextBlock Grid.Row="2" Text="Username" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="UserBox" VerticalAlignment="Center" />

                <TextBlock Grid.Row="3" Text="Authentication" />
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="PasswordRadio" Content="Password" GroupName="Auth" Margin="0,0,16,0" Checked="Auth_Changed" />
                    <RadioButton x:Name="KeyRadio" Content="Private key" GroupName="Auth" Checked="Auth_Changed" />
                </StackPanel>

                <!-- Password auth -->
                <Grid Grid.Row="4" Grid.ColumnSpan="2" x:Name="PasswordPanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Password" Height="34" Padding="0,8,0,0" />
                    <PasswordBox Grid.Column="1" x:Name="PasswordBox" VerticalAlignment="Center" />
                </Grid>

                <!-- Key auth -->
                <Grid Grid.Row="4" Grid.ColumnSpan="2" x:Name="KeyPanel" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="34" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Key file" />
                    <DockPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button DockPanel.Dock="Right" Content="Browse…" Margin="6,0,0,0" Click="BrowseKey_Click" />
                        <TextBox x:Name="KeyPathBox" />
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="Passphrase" />
                    <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="PassphraseBox" VerticalAlignment="Center"
                                 ToolTip="Leave blank if the key is not encrypted" />
                </Grid>

                <TextBlock Grid.Row="5" Text="Remote folder" />
                <TextBox Grid.Row="5" Grid.Column="1" x:Name="FolderBox" VerticalAlignment="Center"
                         ToolTip="Absolute path (/srv/drop) or relative to home (uploads, ~/uploads). Blank = home directory." />
                <TextBlock Grid.Row="6" Grid.Column="1" Foreground="Gray" FontSize="11" Margin="0,0,0,4"
                           Text="e.g. /var/www/uploads or ~/incoming — blank uploads to the home directory" />

                <CheckBox Grid.Row="7" Grid.Column="1" x:Name="CreateFolderCheck" VerticalAlignment="Center"
                          Content="Create remote folder if it doesn't exist (mkdir -p)" />

                <TextBlock Grid.Row="8" Text="Host key" Margin="0,6,10,0" VerticalAlignment="Top" />
                <DockPanel Grid.Row="8" Grid.Column="1" Margin="0,4,0,0">
                    <Button DockPanel.Dock="Right" Content="Forget" Margin="6,0,0,0" Click="ClearHostKey_Click"
                            ToolTip="Forget the trusted key; you'll be asked to verify it again on next connect" />
                    <TextBox x:Name="HostKeyBox" IsReadOnly="True" Foreground="DimGray" FontFamily="Consolas" FontSize="11" />
                </DockPanel>

                <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal" Margin="0,14,0,0">
                    <Button x:Name="TestButton" Content="Test connection" Click="Test_Click" />
                </StackPanel>
                <TextBlock Grid.Row="10" Grid.Column="1" x:Name="TestResultText" TextWrapping="Wrap" Margin="0,8,0,0" />
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save" IsDefault="True" Margin="0,0,8,0" Click="Save_Click" />
            <Button Content="Cancel" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
